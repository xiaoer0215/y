{
  "name": "ai-helper",
  "version": "0.5.20",
  "description": "Uocode Client - AI desktop client",
  "type": "module",
  "scripts": {
    "dev": "pnpm tauri dev",
    "build": "pnpm tauri build",
    "tauri": "tauri",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,json}\" && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "lint:rs": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "bump": "powershell -ExecutionPolicy Bypass -File scripts/bump-version.ps1",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1",
    "sync:web": "node scripts/sync-website.js",
    "preview:web": "powershell -Command \"Start-Process 'website/index.html'\"",
    "serve:web": "python -m http.server 3000 --directory website",
    "validate:brands": "node scripts/validate-brands.mjs",
    "select:brand": "node scripts/select-brand.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.12.3",
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-log": "2.10.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@types/gsap": "^3.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gsap": "^3.15.1",
    "i18next": "^27.0.1",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-icons": "5.7.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  }
}
