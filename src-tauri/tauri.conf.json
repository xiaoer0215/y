{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Uocode Client",
  "version": "0.5.19",
  "identifier": "com.uocode.helper",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Uocode Client",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        },
        "shadow": true,
        "width": 1400,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "visible": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "template": "wix/per-user-main.wxs"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFMTZEN0U1NzJGQzRBNzAKUldSd1N2eHk1ZGNXanEvWjEvTnd1Q2VKMVV2bENvL1E0T2llbWh4eUx5dERRRVJGalhBUkM4blYK",
      "endpoints": [
        "https://www.uocode.com/downloads/uocode/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
